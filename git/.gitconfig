[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[credential]
	helper = osxkeychain
[user]
	name = Kelvin Cuesta
	email = kelvinscuesta@gmail.com
	signingkey = /Users/kelvin.cuesta/.ssh/id_ed25519.pub
[core]
	pager = delta
[include]
	path = ~/.gitconfig.local
[interactive]
	diffFilter = delta --color-only
[color]
	ui = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[merge]
	conflictstyle = zdiff3
[commit]
	gpgsign = true
	verbose = true
[gpg]
	format = ssh
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoSquash = true
	updateRefs = true
	autoStash = true
[pull]
	rebase = true
[alias]
	# Log (pretty formats)
	lg = log --oneline --graph --decorate
	ll = log --oneline -n 15
	last = log -1 HEAD --stat
	hist = log --pretty=format:'%C(yellow)%h%Creset %ad | %s%C(auto)%d%Creset %C(dim)<%an>%Creset' --date=short

	# Branch
	bra = branch -a
	brv = branch -vv
	brd = branch -d
	brD = branch -D
	gone = "!git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}'"

	# Diff
	ds = diff --staged
	dc = diff --cached
	stat = diff --stat

	# Stash
	sth = stash
	sthp = stash pop
	sthl = stash list
	sths = stash show -p

	# Reset / Undo
	unstage = reset HEAD --
	undo = reset --soft HEAD~1
	discard = checkout --

	# Misc
	aliases = config --get-regexp alias
	root = rev-parse --show-toplevel
	whoami = "!echo $(git config user.name) '<'$(git config user.email)'>'"
	branches = for-each-ref --sort=-committerdate refs/heads/ --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(objectname:short)%(color:reset) - %(contents:subject) - %(authorname) (%(color:green)%(committerdate:relative)%(color:reset))'
	dft = \\!GIT_EXTERNAL_DIFF=difft git diff
	dfl = \\!GIT_EXTERNAL_DIFF=difft git log -p --ext-diff
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[delta]
	navigate = true
	side-by-side = true
	syntax-theme = gruvbox-dark
	minus-style = syntax "#3c1f1e"
	minus-emph-style = syntax "#72302a"
	plus-style = syntax "#1d2a1d"
	plus-emph-style = syntax "#2e4430"
	line-numbers-minus-style = "#ea6962" bold
	line-numbers-plus-style = "#a9b665" bold
	line-numbers-zero-style = "#7c6f64"
	hunk-header-style = syntax bold
	hunk-header-decoration-style = "#d8a657" ul ol
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
