# Workflow server environment template.
# Copy to ~/.claude/workflow-server/.env and fill in per-user values.

# Dashboard + polling cadence
DASHBOARD_PORT=3000
JIRA_INTERVAL_MS=7200000        # 2h
PR_INTERVAL_MS=1800000          # 30min
STALE_INTERVAL_MS=3600000       # 1h
SLACK_DRAIN_INTERVAL_MS=300000  # 5min
DRAIN_INTERVAL_MS=15000         # 15s — pick up pending markers from /wf-* slash commands

# Runner behaviour
WORKFLOW_HEADLESS_MODE=permissive   # "permissive" adds --dangerously-skip-permissions to headless claude
AUTO_DRAIN=1
IGNORE_WORK_HOURS=0
MAC_NOTIFY_ENABLED=1

# Slack mirror filter — only high-signal events cross-post to your automation channel.
# NOTIFY/CLASSIFY/FEED/APPROVE/START/STOP/ACK stay local to the audit log.
SLACK_MIRROR_ACTIONS=RUN:FAIL,RUN:OK,CLEANUP,JIRA:TRANSITION,STALE,PLAN,DRAFT

# Work-specific — fill these in yourself. Skills read SLACK_CHANNEL_ID at runtime.
SLACK_CHANNEL_ID=YOUR_SLACK_CHANNEL_ID
SLACK_CHANNEL_NAME=your-automation-channel
JIRA_PROJECT=YOUR_PROJECT_PREFIX        # e.g. PAY
GITHUB_REPOS=Org/repo-one,Org/repo-two  # comma-separated list to poll PRs across
BRANCH_PREFIX=yourname                  # used by wf-implement when naming branches
