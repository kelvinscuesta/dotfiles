#!/bin/bash
# Listens to kanata's TCP server and shows macOS notifications on layer changes.

PORT=5829

notify() {
  osascript -e "display notification \"$2\" with title \"Kanata\" subtitle \"$1\""
}

while true; do
  nc 127.0.0.1 "$PORT" 2>/dev/null | while IFS= read -r line; do
    layer=$(echo "$line" | python3 -c "
import sys, json
try:
    d = json.loads(sys.stdin.read())
    if 'LayerChange' in d:
        print(d['LayerChange']['new'])
except:
    pass
" 2>/dev/null)
    case "$layer" in
      gaming)  notify "Gaming mode" "Homerow mods OFF" ;;
      default) notify "Normal mode" "Homerow mods ON"  ;;
    esac
  done
  # kanata not running or connection dropped — retry
  sleep 3
done
